# Copy to .env.migrate (git-ignored) and fill in. Used ONLY by scripts/migrate-to-cloudinary.mjs.
# These are secrets — never put them in .env / the Vite bundle.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard (Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: only migrate the first N photos (handy for a test run)
# MIGRATE_LIMIT=3
